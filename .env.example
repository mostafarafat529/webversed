# Copy this file to `.env` and fill in your own keys.
# Create React App only exposes REACT_APP_* variables to the browser bundle,
# so these values are visible to end users. Do not use production secrets here.

# WeatherAPI.com current weather endpoint
REACT_APP_WEATHER_API_KEY=your_weatherapi_key_here

# Other keys used by this project (add only if you use the corresponding tool):
# REACT_APP_OPENAI_API_KEY=your_openai_key_here
# REACT_APP_OPENCAGE_API_KEY=your_opencage_key_here
# REACT_APP_NEWS_API_KEY=your_newsapi_key_here